.venv/
__pycache__/
*.pyc
data/cache/
# Piloto de riesgo: la cartera real del usuario. Nunca al repositorio.
data/piloto/
reports/*.png
reports/*.csv
.pytest_cache/
.env
.claude/
*.log
investigacion/busquedas/cache/
investigacion/clave_openalex.txt

# Material de terceros: se descarga con investigacion/recolectar.py, pero no se
# redistribuye (varios autores solo permiten uso personal).
investigacion/**/*.pdf
# Borrador de tesis: publicarlo antes de presentarlo haria que el antiplagio
# (Turnitin) marque la propia tesis como coincidencia con este repositorio.
investigacion/proyecto_de_tesis/
# Generados: se rehacen solos en cada ejecucion.
reports/dashboard.html
reports/laboratorio/
reports/riesgo/
laboratorio/r/*.html
laboratorio/r/*_files/
laboratorio/r/.Rproj.user/
.ipynb_checkpoints/
# Datos de Binance para la clase: se generan con `python -m cryptoquant paquete`
# y se reparten por Drive y Posit Cloud, no por el repositorio.
clase/**/datos/
clase/**/*.csv
investigacion/busquedas/*/openalex_*.json
investigacion/busquedas/*/alicia_*.json
